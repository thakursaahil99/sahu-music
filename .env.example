# ─────────────────────────────────────────────────────────────
# SAHU MUSIC – environment variables
# Copy to apps/web/.env.local and apps/admin/.env.local
# Everything here is OPTIONAL. With nothing set, the website runs
# in guest mode against the public Audius API (no key required).
# ─────────────────────────────────────────────────────────────

# Supabase (free tier). Project Settings → API.
# ONLY the anon/public key goes here. NEVER put the service_role key
# in any NEXT_PUBLIC_* variable or in the Flutter app.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Audius – no key needed; an app name identifies your client to Audius.
NEXT_PUBLIC_AUDIUS_APP_NAME=SAHU_MUSIC

# Jamendo (optional second provider). Free client_id from
# https://devportal.jamendo.com – free for NON-COMMERCIAL use only.
NEXT_PUBLIC_JAMENDO_CLIENT_ID=

# ORIGINAL FILM SONGS (Bollywood, T-Series, Sony, Zee…) in YouTube's OFFICIAL player.
# Free key: Google Cloud console → enable "YouTube Data API v3" → Credentials → API key.
# Restrict the key to your site's address (HTTP referrers) – it is visible in the browser.
# Free quota: 10,000 units/day ≈ 100 typed searches a day (the chart costs 1 unit).
# The video stays on screen while it plays; it does not play in the background.
NEXT_PUBLIC_YOUTUBE_API_KEY=
NEXT_PUBLIC_YOUTUBE_REGION=IN

# Live radio (Radio Browser directory) and openly licensed Internet Archive audio.
# Free, no key, on by default. Set to false to switch a source off.
NEXT_PUBLIC_RADIO=true
NEXT_PUBLIC_ARCHIVE=true

# 30-second preview clips (Apple iTunes Search API). OFF by default.
# SAHU MUSIC plays COMPLETE songs only, from sources that authorise full streaming
# (Audius, Jamendo). Label-owned film songs exist on free APIs only as 30-second
# clips; setting this to true adds them, clearly marked "Preview". Leave false
# to never show or play a preview clip.
NEXT_PUBLIC_ITUNES_PREVIEWS=false
NEXT_PUBLIC_ITUNES_COUNTRY=IN

# Android APK download button on the website. Leave empty to serve the file
# bundled by "npm run apk" (apps/web/public/downloads/sahu-music.apk), or set a
# full https URL (e.g. a GitHub Releases asset) when the APK is hosted elsewhere.
NEXT_PUBLIC_APK_URL=

# Force demo mode (original synthesized sample audio, no network catalogue).
NEXT_PUBLIC_DEMO_MODE=false

# Public site URL (used for SEO metadata / sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional web advertising slot (Google AdSense). Leave empty to disable ads.
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT=

# ── Supabase Edge Functions only (set with `supabase secrets set`, never in frontend) ──
# SUPABASE_SERVICE_ROLE_KEY=   (auto-injected inside Edge Functions)

# ── Flutter (pass with --dart-define, see apps/mobile/README.md) ──
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# AUDIUS_APP_NAME=SAHU_MUSIC
# YOUTUBE_API_KEY=            (restrict it to the Android/iOS app in Google Cloud)
# ADS_ENABLED=false
# ADMOB_BANNER_ANDROID=
# ADMOB_BANNER_IOS=
