{
  "name": "sahu-music",
  "private": true,
  "version": "1.0.0",
  "description": "SAHU MUSIC - Har Gaana, Ek Jagah. Free-first music streaming ecosystem.",
  "workspaces": [
    "apps/web",
    "apps/admin",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @sahu/web",
    "dev:admin": "npm run dev -w @sahu/admin",
    "build": "npm run build -w @sahu/web && npm run build -w @sahu/admin",
    "build:web": "npm run build -w @sahu/web",
    "build:admin": "npm run build -w @sahu/admin",
    "typecheck": "npm run typecheck -w @sahu/web && npm run typecheck -w @sahu/admin",
    "test": "vitest run",
    "test:api": "node scripts/api-smoke-test.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "test:playback": "node scripts/full-length-test.mjs",
    "apk": "node scripts/build-apk.mjs",
    "test:e2e": "node scripts/e2e-playback.mjs",
    "youtube": "node scripts/setup-youtube.mjs"
  },
  "devDependencies": {
    "sharp": "^0.33.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=18.18"
  }
}
